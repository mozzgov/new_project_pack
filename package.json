{
  "name": "frontend-starter",
  "version": "2.0.0",
  "description": "Lightweight Vite + TypeScript + SCSS + Bootstrap frontend starter",
  "type": "module",
  "private": true,
  "author": "Maxim Mozzgov",
  "license": "ISC",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "build:wp": "vite build --mode wp",
    "watch:wp": "vite build --watch --mode wp",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "bootstrap": "^5.3.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.5",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "sass-embedded": "^1.104.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  }
}
